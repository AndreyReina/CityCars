{
  "name": "citycars",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "node --env-file=.env --watch backend/servidor.js",
    "start": "node --env-file=.env backend/servidor.js",
    "db:start": "node herramientas/baseLocal.js start",
    "db:stop": "node herramientas/baseLocal.js stop",
    "db:migrate": "node --env-file=.env herramientas/migrar.js",
    "db:seed": "node --env-file=.env herramientas/sembrar.js",
    "test": "node --env-file=.env --test pruebas/*.test.js",
    "format": "prettier --write \"frontend/src/**/*.{js,svelte,css}\" \"backend/**/*.js\" \"herramientas/*.js\" \"pruebas/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "vite": "^7.0.0"
  }
}
